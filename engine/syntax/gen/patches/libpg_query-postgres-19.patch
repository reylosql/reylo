+			deparseAppendStringInfoString(state, first ? " EXCEPT (TABLE " : ", ");
+			deparseRangeVar(state, obj->pubtable->relation, DEPARSE_NODE_CONTEXT_NONE);
+			first = false;
+		}
+		if (!first)
+			deparseAppendStringInfoChar(state, ')');
+		if (all_sequences)
+			deparseAppendStringInfoString(state, ", ");
+	}
+	if (all_sequences)
+		deparseAppendStringInfoString(state, "ALL SEQUENCES");
+	deparseAppendStringInfoChar(state, ' ');
+}
