  { "case": "several hosts and ports, and the role", "url": "postgres:///shop?host=a,b&port=5432,5433&user=app", "server": "postgres://@/shop?host=a,b&port=5432,5433&user=app" },
  { "case": "a repeated parameter keeps its place, though the engine reads its last", "url": "postgres:///shop?host=b&dbname=x&host=a", "server": "postgres://@/shop?host=b&dbname=x&host=a" },
