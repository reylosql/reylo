  { "case": "a Unix socket's directory, escaped, which names an entry of its own", "url": "postgres:///shop?host=%2Fvar%2Frun%2Fpostgresql", "server": "postgres://@/shop?host=%2Fvar%2Frun%2Fpostgresql" },
  { "case": "several hosts and ports, and the role", "url": "postgres:///shop?host=a,b&port=5432,5433&user=app", "server": "postgres://@/shop?host=a,b&port=5432,5433&user=app" },
  { "case": "a repeated parameter keeps its place, which picks the host tried first", "url": "postgres:///shop?host=b&dbname=x&host=a", "server": "postgres://@/shop?host=b&dbname=x&host=a" },
  { "case": "a name is matched decoded, as the bridge to a Unix socket reads it, and kept as written", "url": "postgres:///app?%68ost=%2Ftmp%2Fpg-a", "server": "postgres://@/app?%68ost=%2Ftmp%2Fpg-a" },
  { "case": "options, which may set the search path", "url": "postgres://app@db.internal/shop?options=-c%20search_path%3Dtenant_1", "server": "postgres://app@db.internal/shop?options=-c%20search_path%3Dtenant_1" },
  { "case": "a MySQL socket", "url": "mysql://root@127.0.0.1:3306/app?socketPath=/tmp/mysql.sock&ssl=true", "server": "mysql://root@127.0.0.1:3306/app?socketPath=/tmp/mysql.sock" },
  { "case": "a MySQL socket's name, escaped", "url": "mysql://root@localhost/app?%73ocketPath=/tmp/a.sock", "server": "mysql://root@localhost/app?%73ocketPath=/tmp/a.sock" },
  { "case": "a MySQL socket with a +, which the engine reads as a space and the bridge to a Unix socket as a plus", "url": "mysql://root@localhost/app?socketPath=/tmp/a+b.sock", "server": "mysql://root@localhost/app?socketPath=/tmp/a+b.sock" },
  { "case": "a MySQL socket named twice, whose last the engine opens", "url": "mysql://root@localhost/app?socket=/tmp/a.sock&socketPath=/tmp/b.sock", "server": "mysql://root@localhost/app?socket=/tmp/a.sock&socketPath=/tmp/b.sock" },
  { "case": "a MySQL socket named twice the other way round, which the engine opens another socket for", "url": "mysql://root@localhost/app?socketPath=/tmp/b.sock&socket=/tmp/a.sock", "server": "mysql://root@localhost/app?socketPath=/tmp/b.sock&socket=/tmp/a.sock" },
  { "case": "a parameter MySQL does not read", "url": "mysql://root@127.0.0.1:3306/app?dbname=other", "server": "mysql://root@127.0.0.1:3306/app" },
  { "case": "ClickHouse's database and the path in front of its interface", "url": "clickhouse+http://default:reylo@127.0.0.1:8123/?ch_join_use_nulls=1&pathname=/proxy&ch_database=a", "server": "clickhouse+http://default@127.0.0.1:8123/?pathname=/proxy&ch_database=a" },
  { "case": "a ClickHouse database with a +, which ClickHouse reads as a space", "url": "clickhouse+http://default@127.0.0.1:8123/?ch_database=a+b", "server": "clickhouse+http://default@127.0.0.1:8123/?ch_database=a+b" },
