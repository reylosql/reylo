[
  { "case": "a URL with no parameter that chooses the database keeps the name its entries had", "url": "postgres://app:secret@db.internal:5432/shop?sslmode=require&application_name=web", "server": "postgres://app@db.internal:5432/shop" },
  { "case": "dbname chooses the database", "url": "postgres://postgres@127.0.0.1:5432/?dbname=a", "server": "postgres://postgres@127.0.0.1:5432/?dbname=a" },
  { "case": "a value is kept as the URL writes it, so that an escape names an entry of its own", "url": "postgres://postgres@127.0.0.1:5432/?dbname=%61", "server": "postgres://postgres@127.0.0.1:5432/?dbname=%61" },
  { "case": "a query with no path before it", "url": "postgres://app@db.internal?sslmode=require", "server": "postgres://app@db.internal" },
  { "case": "in the URL's order, and never a password or a key file", "url": "postgres://app:secret@db.internal/?sslkey=/keys/app.key&port=5433&sslpassword=hunter2&dbname=shop", "server": "postgres://app@db.internal/?port=5433&dbname=shop" },
  { "case": "a + is kept as written, which libpq reads as a plus", "url": "postgres://db.internal/?dbname=a+b", "server": "postgres://@db.internal/?dbname=a+b" },
