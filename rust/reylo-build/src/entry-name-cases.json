  { "case": "a part the URL names is never a variable's", "env": { "PGHOST": "other", "PGPORT": "6543", "PGUSER": "ci", "PGDATABASE": "other" }, "url": "postgres://app@db.internal:5432/shop", "server": "postgres://app@db.internal:5432/shop" },
  { "case": "nor a part its parameters name", "env": { "PGHOST": "other", "PGPORT": "6543", "PGUSER": "ci", "PGDATABASE": "other" }, "url": "postgres:///?dbname=shop&host=h&port=1&user=u", "server": "postgres://@/?dbname=shop&host=h&port=1&user=u" },
  { "case": "PGHOST where the URL names no host, encoded", "env": { "PGHOST": "/var/run/postgresql" }, "url": "postgres:///shop", "server": "postgres://@/shop?PGHOST=%2Fvar%2Frun%2Fpostgresql" },
  { "case": "libpq's own form for a Unix socket, which the URL parser refuses, with the password left out and PGPORT in", "env": { "PGPORT": "5433" }, "url": "postgres://app:secret@/shop?host=/var/run/postgresql", "server": "postgres://app@/shop?host=/var/run/postgresql&PGPORT=5433" },
  { "case": "several hosts with their ports, which the URL parser refuses", "env": { "PGPORT": "6543" }, "url": "postgres://app@a:5432,b:5433/shop", "server": "postgres://app@a:5432,b:5433/shop" },
  { "case": "several hosts with no port take 5432 each, never PGPORT", "env": { "PGPORT": "6543" }, "url": "postgres://app@a,b/shop", "server": "postgres://app@a,b/shop" },
