{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "build/client",
  "functions": {
    "api/play/*.mjs": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": ".live/{engine/*.wasm,postgres.tar,pglite.wasm,pglite-data.tar}"
    },
    "api/play-og/image.mjs": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "assets/fonts/{Geist-600,GeistMono-400}.ttf"
    },
    "api/play-og/page.mjs": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/typedefs/(preview|\\d+\\.\\d+\\.\\d+)\\.json$",
      "headers": {
        "Content-Type": "application/schema+json",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/play/api/(analyze|schema)$",
      "dest": "/api/play/$1"
    },
    {
      "src": "^/play/og\\.png$",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "dest": "/api/play-og/image"
    },
    {
      "src": "^/play/og\\.png$",
      "has": [
        {
          "type": "query",
          "key": "example"
        }
      ],
      "dest": "/api/play-og/image"
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/play/api.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "query",
          "key": "q"
        },
        {
          "type": "header",
          "key": "accept",
          "value": "^(?!.*text/html).*application/json.*$"
        }
      ],
      "dest": "/api/play/analyze",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "dest": "/api/play-og/page",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "query",
          "key": "example"
        }
      ],
      "dest": "/api/play-og/page",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "^/(?:docs)?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/(typescript|rust|inference|configuration|compare|faq|cli|postgres|mysql|sqlite|clickhouse|neon|supabase|durable-objects|planetscale|d1|turso|hyperdrive|nextjs|deployment|prisma|typedefs)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/migrate(?:/docs)?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/migrate.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/migrate/(usage|cli|compare)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/migrate-$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    }
  ],
  "redirects": [
    {
      "source": "/duckdb",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/schema-changes",
      "destination": "/typescript#when-the-schema-changes",
      "permanent": true
    },
    {
      "source": "/migrations",
      "destination": "/migrate/docs",
      "permanent": true
    },
    {
      "source": "/cloudflare",
      "destination": "/d1",
      "permanent": true
    },
    {
      "source": "/usage",
      "destination": "/typescript",
      "permanent": true
    },
    {
      "source": "/observability",
      "destination": "/typescript#observability",
      "permanent": true
    },
    {
      "source": "/opengraph-image",
      "destination": "/opengraph-image.png",
      "permanent": true
    },
    {
      "source": "/ci",
      "destination": "/deployment",
      "permanent": true
    },
    {
      "source": "/hosted",
      "destination": "/neon",
      "permanent": true
    },
    {
      "source": "/rtd",
      "destination": "/typedefs",
      "permanent": true
    },
    {
      "source": "/details",
      "destination": "/configuration",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:page(|docs|typescript|rust|inference|configuration|compare|faq|cli|postgres|mysql|sqlite|clickhouse|neon|supabase|durable-objects|planetscale|d1|turso|hyperdrive|nextjs|deployment|prisma|typedefs|migrate|play)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/migrate/:sub(docs|usage|cli|compare)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|.*\\.md)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
