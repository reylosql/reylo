{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "build/client",
  "functions": {
    "api/play/*.mjs": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": ".live/{engine/*.wasm,postgres.tar,pglite.wasm,pglite-data.tar}"
    },
    "api/play-og/image.mjs": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "assets/fonts/{Geist-600,GeistMono-400}.ttf"
    },
    "api/play-og/page.mjs": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/typedefs/(preview|\\d+\\.\\d+\\.\\d+)\\.json$",
      "headers": {
        "Content-Type": "application/schema+json",
        "Access-Control-Allow-Origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/play/api/(analyze|schema)$",
      "dest": "/api/play/$1"
    },
    {
      "src": "^/play/og\\.png$",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "dest": "/api/play-og/image"
    },
    {
      "src": "^/play/og\\.png$",
      "has": [
        {
          "type": "query",
          "key": "example"
        }
      ],
      "dest": "/api/play-og/image"
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/play/api.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "query",
          "key": "q"
        },
        {
          "type": "header",
          "key": "accept",
          "value": "^(?!.*text/html).*application/json.*$"
        }
      ],
      "dest": "/api/play/analyze",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "query",
          "key": "q"
        }
      ],
      "dest": "/api/play-og/page",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "^/play$",
      "has": [
        {
          "type": "query",
          "key": "example"
        }
      ],
      "dest": "/api/play-og/page",
      "headers": {
        "Vary": "Accept"
      }
    },
    {
      "src": "^/(?:docs)?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/docs.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/docs/(typescript|rust|inference|configuration|compare|faq|cli|postgres|mysql|sqlite|clickhouse|neon|supabase|durable-objects|planetscale|d1|turso|hyperdrive|nextjs|deployment|prisma|typedefs|migrate)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/docs/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/docs/migrate/(usage|cli|compare)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/docs/migrate/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/migrate$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/docs/migrate.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/blog$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/blog.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    },
    {
      "src": "^/blog/([a-z0-9-]+)$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^(?:(?!(?:^|,)\\s*text/html(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$))).)*(?:^|,)\\s*text/(?:x-)?markdown(?![^,]*;\\s*[qQ]\\s*=\\s*0(?:\\.0*)?(?=\\s*(?:;|,|$)))(?=\\s*(?:;|,|$)).*$"
        }
      ],
      "dest": "/blog/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      }
    }
  ],
  "redirects": [
    {
      "source": "/typescript",
      "destination": "/docs/typescript",
      "permanent": true
    },
    {
      "source": "/rust",
      "destination": "/docs/rust",
      "permanent": true
    },
    {
      "source": "/inference",
      "destination": "/docs/inference",
      "permanent": true
    },
    {
      "source": "/compare",
      "destination": "/docs/compare",
      "permanent": true
    },
    {
      "source": "/faq",
      "destination": "/docs/faq",
      "permanent": true
    },
    {
      "source": "/migrate/docs",
      "destination": "/docs/migrate",
      "permanent": true
    },
    {
      "source": "/migrate/usage",
      "destination": "/docs/migrate/usage",
      "permanent": true
    },
    {
      "source": "/migrate/cli",
      "destination": "/docs/migrate/cli",
      "permanent": true
    },
    {
      "source": "/migrate/compare",
      "destination": "/docs/migrate/compare",
      "permanent": true
    },
    {
      "source": "/neon",
      "destination": "/docs/neon",
      "permanent": true
    },
    {
      "source": "/supabase",
      "destination": "/docs/supabase",
      "permanent": true
    },
    {
      "source": "/durable-objects",
      "destination": "/docs/durable-objects",
      "permanent": true
    },
    {
      "source": "/planetscale",
      "destination": "/docs/planetscale",
      "permanent": true
    },
    {
      "source": "/d1",
      "destination": "/docs/d1",
      "permanent": true
    },
    {
      "source": "/turso",
      "destination": "/docs/turso",
      "permanent": true
    },
    {
      "source": "/hyperdrive",
      "destination": "/docs/hyperdrive",
      "permanent": true
    },
    {
      "source": "/nextjs",
      "destination": "/docs/nextjs",
      "permanent": true
    },
    {
      "source": "/deployment",
      "destination": "/docs/deployment",
      "permanent": true
    },
    {
      "source": "/configuration",
      "destination": "/docs/configuration",
      "permanent": true
    },
    {
      "source": "/cli",
      "destination": "/docs/cli",
      "permanent": true
    },
    {
      "source": "/postgres",
      "destination": "/docs/postgres",
      "permanent": true
    },
    {
      "source": "/mysql",
      "destination": "/docs/mysql",
      "permanent": true
    },
    {
      "source": "/sqlite",
      "destination": "/docs/sqlite",
      "permanent": true
    },
    {
      "source": "/clickhouse",
      "destination": "/docs/clickhouse",
      "permanent": true
    },
    {
      "source": "/prisma",
      "destination": "/docs/prisma",
      "permanent": true
    },
    {
      "source": "/typedefs",
      "destination": "/docs/typedefs",
      "permanent": true
    },
    {
      "source": "/index.md",
      "destination": "/docs.md",
      "permanent": true
    },
    {
      "source": "/migrate-:sub(usage|cli|compare).md",
      "destination": "/docs/migrate/:sub.md",
      "permanent": true
    },
    {
      "source": "/:page(typescript|rust|inference|configuration|compare|faq|cli|postgres|mysql|sqlite|clickhouse|neon|supabase|durable-objects|planetscale|d1|turso|hyperdrive|nextjs|deployment|prisma|typedefs|migrate).md",
      "destination": "/docs/:page.md",
      "permanent": true
    },
    {
      "source": "/duckdb",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/schema-changes",
      "destination": "/docs/typescript",
      "permanent": true
    },
    {
      "source": "/migrations",
      "destination": "/docs/migrate",
      "permanent": true
    },
    {
      "source": "/cloudflare",
      "destination": "/docs/d1",
      "permanent": true
    },
    {
      "source": "/usage",
      "destination": "/docs/typescript",
      "permanent": true
    },
    {
      "source": "/observability",
      "destination": "/docs/typescript#observability",
      "permanent": true
    },
    {
      "source": "/opengraph-image",
      "destination": "/opengraph-image.png",
      "permanent": true
    },
    {
      "source": "/ci",
      "destination": "/docs/deployment",
      "permanent": true
    },
    {
      "source": "/hosted",
      "destination": "/docs/neon",
      "permanent": true
    },
    {
      "source": "/rtd",
      "destination": "/docs/typedefs",
      "permanent": true
    },
    {
      "source": "/details",
      "destination": "/docs/configuration",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:page(|docs|migrate|blog|play)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs/:page(typescript|rust|inference|configuration|compare|faq|cli|postgres|mysql|sqlite|clickhouse|neon|supabase|durable-objects|planetscale|d1|turso|hyperdrive|nextjs|deployment|prisma|typedefs|migrate)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs/migrate/:sub(usage|cli|compare)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/blog/:slug",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms\\.txt|.*\\.md)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
